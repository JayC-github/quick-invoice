{
  "name": "quickinvoice",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "npx cross-env DYNAMODB_ENDPOINT=http://localhost:8001 JWT_SECRET=local-dev-secret npx tsx src/local-server.ts",
    "db:setup": "npx cross-env DYNAMODB_ENDPOINT=http://localhost:8001 npx tsx scripts/setup-local-db.ts",
    "test": "vitest --run",
    "test:unit": "vitest --run tests/unit",
    "test:property": "vitest --run tests/property",
    "test:integration": "vitest --run tests/integration",
    "test:watch": "vitest"
  },
