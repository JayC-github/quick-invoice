  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.967.0",
    "@aws-sdk/lib-dynamodb": "^3.967.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.18.0",
    "uuid": "^14.0.0",
    "express": "^5.1.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
